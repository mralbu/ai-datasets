---
// Fisher's discriminant on all 150 iris flowers (src/paper-figures/fisher-1936.json, from
// scripts/papers.py figures): one row of dots per species along the first discriminant.
import data from '../../paper-figures/fisher-1936.json';
const species = ['setosa', 'versicolor', 'virginica'];
const xs = data.points.map((p) => p.ld1);
const [lo, hi] = [Math.min(...xs), Math.max(...xs)];
const W = 640, H = 210, L = 92, R = 16, T = 12, B = 34, row = (H - T - B) / 3;
const x = (v: number) => L + ((v - lo) / (hi - lo)) * (W - L - R);
// Small deterministic jitter so overlapping flowers stay visible.
const jit = (i: number) => (((i * 7919) % 97) / 97 - 0.5) * row * 0.5;
const ticks = Array.from({ length: Math.floor(hi) - Math.ceil(lo) + 1 }, (_, i) => Math.ceil(lo) + i).filter((t) => t % 2 === 0);
const short: Record<string, string> = { SepalLengthCm: 'sepal length', SepalWidthCm: 'sepal width', PetalLengthCm: 'petal length', PetalWidthCm: 'petal width' };
const w = data.weights[0];
const formula = data.features.map((f, i) => `${w[i] >= 0 && i ? '+ ' : i ? '− ' : w[i] < 0 ? '−' : ''}${Math.abs(w[i]).toFixed(2)}·${short[f]}`).join(' ');
---
<div class="fisher">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Dot plot of the first discriminant for the three iris species; setosa is far to the left, versicolor and virginica barely overlap">
    {ticks.map((t) => (
      <>
        <line class="grid" x1={x(t)} x2={x(t)} y1={T} y2={H - B} />
        <text class="tick" x={x(t)} y={H - B + 16} text-anchor="middle">{t}</text>
      </>
    ))}
    {species.map((sp, k) => (
      <>
        <text class="lab" x={L - 10} y={T + row * (k + 0.5) + 4} text-anchor="end">{sp}</text>
        {data.points.map((p, i) => [p, i] as const).filter(([p]) => p.species === sp).map(([p, i]) => (
          <circle class={`d ${sp}`} cx={x(p.ld1)} cy={T + row * (k + 0.5) + jit(i)} r="4.5">
            <title>{`Iris ${sp}: discriminant ${p.ld1.toFixed(2)} (petal ${p.petal_length} × ${p.petal_width} cm)`}</title>
          </circle>
        ))}
      </>
    ))}
    <text class="tick" x={(L + W - R) / 2} y={H - 4} text-anchor="middle">first discriminant (one weighted sum of the four measurements)</text>
  </svg>
  <p class="formula muted">Discriminant = {formula} <span>({Math.round(data.share[0] * 100)}% of the separation between species)</span></p>
</div>
<style>
  .fisher svg { width: 100%; max-width: 680px; height: auto; display: block; }
  .grid { stroke: var(--border); stroke-width: 1; }
  .tick { fill: var(--muted); font-size: 11px; }
  .lab { fill: var(--text); font-size: 12.5px; font-style: italic; }
  .d { stroke: var(--surface); stroke-width: 1.5; fill-opacity: 0.85; }
  .setosa { fill: var(--sp1); } .versicolor { fill: var(--sp2); } .virginica { fill: var(--sp3); }
  .fisher { --sp1: #2f6fd6; --sp2: #c26a12; --sp3: #1f8a5b; }
  :global(:root[data-theme='dark']) .fisher { --sp1: #5a8fe8; --sp2: #c77a38; --sp3: #35a66c; }
  @media (prefers-color-scheme: dark) { :global(:root:not([data-theme='light'])) .fisher { --sp1: #5a8fe8; --sp2: #c77a38; --sp3: #35a66c; } }
  .formula { font: 0.8rem ui-monospace, Menlo, monospace; margin: 6px 0 0; }
  .formula span { font-family: system-ui, sans-serif; }
</style>
