---
import type { Dataset, Samples } from '../lib/data';
import ImageGrid from './kinds/ImageGrid.astro';
import Boxes from './kinds/Boxes.astro';
import TextList from './kinds/TextList.astro';
import QAList from './kinds/QAList.astro';
import Extractive from './kinds/Extractive.astro';
import MCQ from './kinds/MCQ.astro';
import CodeTask from './kinds/CodeTask.astro';
import AudioList from './kinds/AudioList.astro';
import ArcGrid from './kinds/ArcGrid.astro';
import Record from './kinds/Record.astro';
import Table from './kinds/Table.astro';
import Translation from './kinds/Translation.astro';
import Annotated from './kinds/Annotated.astro';
import ImageMCQ from './kinds/ImageMCQ.astro';
import Preference from './kinds/Preference.astro';
import Segmentation from './kinds/Segmentation.astro';

interface Props { ds: Dataset; samples: Samples }
const { ds, samples: s } = Astro.props;
const d = ds.data.display;
const rows = s.rows;
// How many samples to show at once, per kind.
const SHOW: Record<string, number> = { image: 24, boxes: 6, text: 4, qa: 3, extractive: 3, mcq: 4, code: 2, audio: 4, grid: 2, record: 9, table: 8, translation: 6, annotated: 6, image_mcq: 3, preference: 3, segmentation: 4 };
const k = d.kind === 'image' && d.thumb ? 12 : SHOW[d.kind];
const first = rows[0];
const splitInfo = s.parts && s.parts.length > 1
  ? `${s.parts.length} tasks`
  : `the ${s.source.split} split`;
// Raw JSON can be huge (ARC grids); keep the preview readable.
const raw = first ? JSON.stringify(first.row, null, 2) : '';
const rawShown = raw.length > 6000 ? raw.slice(0, 6000) + '\n… (truncated)' : raw;
const fetched = s.fetched_at.slice(0, 10);
const revUrl = s.revision ? `https://huggingface.co/datasets/${s.source.hf}/tree/${s.revision}` : undefined;
---
<section class="samples" data-k={k}>
  <div class="toolbar">
    <span class="muted">
      Showing <span data-count>{Math.min(k, rows.length)}</span> of {rows.length} sampled rows
      (from {s.num_rows_total.toLocaleString('en-US')} in {splitInfo})
    </span>
    <span class="buttons">
      {d.kind === 'image' && !d.thumb && <button type="button" data-toggle-class="native" aria-pressed="false">Actual pixel size</button>}
      {d.kind === 'boxes' && <button type="button" data-toggle-class="no-boxes" aria-pressed="false">Hide boxes</button>}
      {d.kind === 'segmentation' && <button type="button" data-toggle-class="no-masks" aria-pressed="false">Hide masks</button>}
      {d.kind === 'segmentation' && <button type="button" data-toggle-class="solid" aria-pressed="false">Solid masks</button>}
      {rows.length > k && <button type="button" data-shuffle>Shuffle</button>}
    </span>
  </div>

  {d.kind === 'image' && <ImageGrid s={s} d={d} rows={rows} k={k} />}
  {d.kind === 'boxes' && <Boxes s={s} d={d} rows={rows} k={k} />}
  {d.kind === 'text' && <TextList s={s} d={d} rows={rows} k={k} />}
  {d.kind === 'qa' && <QAList d={d} rows={rows} k={k} />}
  {d.kind === 'extractive' && <Extractive d={d} rows={rows} k={k} />}
  {d.kind === 'mcq' && <MCQ d={d} rows={rows} k={k} />}
  {d.kind === 'code' && <CodeTask d={d} rows={rows} k={k} />}
  {d.kind === 'audio' && <AudioList s={s} d={d} rows={rows} k={k} />}
  {d.kind === 'grid' && <ArcGrid d={d} rows={rows} k={k} />}
  {d.kind === 'record' && <Record s={s} d={d} notes={ds.data.config_notes} rows={rows} k={k} />}
  {d.kind === 'table' && <Table s={s} d={d} rows={rows} k={k} />}
  {d.kind === 'translation' && <Translation d={d} rows={rows} k={k} />}
  {d.kind === 'annotated' && <Annotated s={s} d={d} rows={rows} k={k} />}
  {d.kind === 'image_mcq' && <ImageMCQ d={d} rows={rows} k={k} />}
  {d.kind === 'preference' && <Preference d={d} rows={rows} k={k} />}
  {d.kind === 'segmentation' && <Segmentation d={d} rows={rows} k={k} />}

  {first && (
    <details class="raw">
      <summary>What one record actually looks like (raw JSON, row {first.row_idx})</summary>
      <pre>{rawShown}</pre>
      <p class="muted">Media fields point at a local copy; on Hugging Face they are bytes in a Parquet file.</p>
    </details>
  )}
  <p class="provenance muted">
    Sampled {fetched} from <a href={`https://huggingface.co/datasets/${s.source.hf}`}>{s.source.hf}</a>
    {revUrl && <> at revision <a href={revUrl}><code>{s.revision!.slice(0, 7)}</code></a></>}
  </p>
</section>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('section.samples')) {
    const k = Number(root.dataset.k);
    const items = [...root.querySelectorAll<HTMLElement>('[data-item]')];

    root.querySelector('[data-shuffle]')?.addEventListener('click', () => {
      const idx = items.map((_, i) => i);
      for (let i = idx.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [idx[i], idx[j]] = [idx[j], idx[i]];
      }
      const show = new Set(idx.slice(0, k));
      items.forEach((el, i) => {
        el.hidden = !show.has(i);
        el.classList.remove('revealed', 'open');
        el.querySelectorAll('audio').forEach((a) => a.pause());
      });
      // Show the picked items in a new random order, not dataset order.
      const parent = items[0].parentElement!;
      idx.slice(0, k).forEach((i) => parent.appendChild(items[i]));
      root.querySelectorAll<HTMLButtonElement>('[data-reveal]').forEach(resetReveal);
    });

    // Toolbar toggles that flip a class on the section ("Actual pixel size", "Hide boxes").
    for (const btn of root.querySelectorAll<HTMLButtonElement>('[data-toggle-class]')) {
      btn.addEventListener('click', () => {
        const on = root.classList.toggle(btn.dataset.toggleClass!);
        btn.setAttribute('aria-pressed', String(on));
      });
    }

    // "Show answer" buttons reveal the answer inside their card.
    const labels = new WeakMap<HTMLButtonElement, string>();
    const resetReveal = (btn: HTMLButtonElement) => { btn.textContent = labels.get(btn) ?? btn.textContent; };
    for (const btn of root.querySelectorAll<HTMLButtonElement>('[data-reveal]')) {
      labels.set(btn, btn.textContent ?? '');
      btn.addEventListener('click', () => {
        const card = btn.closest('[data-item]')!;
        const on = card.classList.toggle('revealed');
        btn.textContent = on ? 'Hide answer' : labels.get(btn)!;
      });
    }

    // Long texts are clamped; offer "Show all" only when something is cut off.
    for (const btn of root.querySelectorAll<HTMLButtonElement>('[data-more]')) {
      const card = btn.closest('article')!;
      const p = card.querySelector<HTMLElement>('.clamp')!;
      const check = () => { btn.hidden = !card.classList.contains('open') && p.scrollHeight <= p.clientHeight + 2; };
      new ResizeObserver(check).observe(p);
      btn.addEventListener('click', () => {
        const open = card.classList.toggle('open');
        btn.textContent = open ? 'Show less' : 'Show all';
      });
    }
  }
</script>

<style>
  .toolbar { display: flex; flex-wrap: wrap; gap: 8px 16px; justify-content: space-between; align-items: center; margin-bottom: 14px; font-size: 0.9rem; }
  .buttons { display: flex; gap: 8px; }
  button[aria-pressed='true'] { background: var(--accent-soft); border-color: var(--accent); }
  .raw { margin-top: 18px; }
  .raw summary { cursor: pointer; color: var(--muted); font-size: 0.9rem; }
  .raw pre { max-height: 360px; }
  .provenance { font-size: 0.8rem; margin: 10px 0 0; }

  /* Shared by the sample renderers in ./kinds */
  .samples :global(.list) { display: grid; gap: 14px; }
  .samples :global(.list > [hidden]) { display: none; }
  .samples :global(article.card) { padding: 16px 18px; min-width: 0; }
  .samples :global(.q) { margin: 0 0 10px; font-weight: 500; }
  .samples :global(.pre) { white-space: pre-line; }
  .samples :global(.clamp) { white-space: pre-line; margin: 8px 0 0; display: -webkit-box; -webkit-line-clamp: 6; -webkit-box-orient: vertical; overflow: hidden; }
  .samples :global(.open .clamp) { display: block; }
  .samples :global(.more) { margin-top: 8px; font-size: 0.8rem; padding: 3px 10px; }
  .samples :global(.label) { font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; }
  .samples :global(.label.pos), .samples :global(.label.positive) { color: var(--pos); }
  .samples :global(.label.neg), .samples :global(.label.negative) { color: var(--neg); }
  .samples :global(summary) { cursor: pointer; color: var(--accent); font-size: 0.9rem; }
  .samples :global([data-reveal]) { font-size: 0.85rem; }
</style>
