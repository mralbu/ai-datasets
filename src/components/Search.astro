---
// Site search: a header button that opens a small palette. Press "/" (or Ctrl/⌘ K) anywhere to open it.
// The index is tiny (one entry per dataset), so it is inlined as JSON and searched in the browser.
import { getDatasets, url, MODALITIES } from '../lib/data';
const index = (await getDatasets()).map((d) => ({
  id: d.id,
  name: d.data.name,
  year: d.data.year,
  m: d.data.modality,
  cat: MODALITIES[d.data.modality] ?? d.data.modality,
  task: d.data.task,
  line: d.data.one_liner,
  who: d.data.creators ?? '',
  rel: (d.data.lineage ?? []).filter((l) => !l.id).map((l) => l.name),
  href: url(`/d/${d.id}`),
}));
---
<button type="button" class="search-btn" data-search-open aria-label="Search datasets" aria-keyshortcuts="/">
  <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="8.5" cy="8.5" r="5.5" /><path d="m13 13 4 4" /></svg>
  <span class="ph">Search</span>
  <kbd>/</kbd>
</button>

<dialog class="search" aria-label="Search datasets">
  <div class="box">
    <div class="field">
      <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="8.5" cy="8.5" r="5.5" /><path d="m13 13 4 4" /></svg>
      <input
        type="search" placeholder="Search by name, task, year, creator…" autocomplete="off" spellcheck="false"
        role="combobox" aria-expanded="true" aria-controls="search-results" aria-autocomplete="list"
      />
      <kbd class="esc">Esc</kbd>
    </div>
    <ul id="search-results" role="listbox"></ul>
    <p class="hint muted">
      <span><kbd>↑</kbd><kbd>↓</kbd> move</span><span><kbd>↵</kbd> open</span><span><kbd>/</kbd> search from any page</span>
    </p>
  </div>
</dialog>
<script type="application/json" id="search-index" set:html={JSON.stringify(index).replace(/</g, '\\u003c')} />

<script>
  interface Entry { id: string; name: string; year: number; m: string; cat: string; task: string; line: string; who: string; rel: string[]; href: string }
  const index: Entry[] = JSON.parse(document.getElementById('search-index')!.textContent!);
  const dialog = document.querySelector<HTMLDialogElement>('dialog.search')!;
  const input = dialog.querySelector('input')!;
  const list = dialog.querySelector<HTMLUListElement>('#search-results')!;

  // Lowercase, drop accents; "squash" removes punctuation too, so "cifar10" finds CIFAR-10.
  const norm = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
  const squash = (s: string) => norm(s).replace(/[^a-z0-9]/g, '');
  const prepared = index.map((e) => ({
    e,
    name: squash(e.name) + ' ' + squash(e.id),
    words: norm(`${e.name} ${e.id}`).split(/[^a-z0-9]+/),
    rest: norm(`${e.task} ${e.line} ${e.cat} ${e.year} ${e.who}`),
    rel: e.rel.map(norm),
  }));

  function score(p: (typeof prepared)[number], terms: string[]): { s: number; via?: string } | null {
    let s = 0;
    let via: string | undefined;
    for (const t of terms) {
      const q = squash(t);
      if (!q) continue;
      if (p.words.some((w) => w === q)) s += 100;
      else if (p.name.startsWith(q) || p.words.some((w) => w.startsWith(q))) s += 60;
      else if (p.name.includes(q)) s += 40;
      else if (p.rest.includes(t)) s += 10;
      else {
        const r = p.rel.find((n) => n.includes(t) || squash(n).includes(q));
        if (!r) return null; // every term must match somewhere
        s += 5;
        via ??= p.e.rel[p.rel.indexOf(r)];
      }
    }
    return { s, via };
  }

  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  let results: Entry[] = [];
  let active = 0;

  function render() {
    const raw = norm(input.value.trim());
    const terms = raw.split(/\s+/).filter(Boolean);
    let hits: { e: Entry; s: number; via?: string }[];
    if (!terms.length) hits = index.map((e) => ({ e, s: 0 }));
    else hits = prepared.flatMap((p) => { const r = score(p, terms); return r ? [{ e: p.e, ...r }] : []; });
    hits.sort((a, b) => b.s - a.s || a.e.year - b.e.year);
    results = hits.map((h) => h.e);
    active = Math.min(active, Math.max(results.length - 1, 0));
    list.innerHTML = hits.length
      ? hits.map((h, i) => `
          <li role="option" id="sr-${i}" aria-selected="${i === active}" data-m="${h.e.m}">
            <a href="${h.e.href}" tabindex="-1">
              <span class="dot"></span>
              <span class="txt">
                <span class="name">${esc(h.e.name)} <span class="yr">${h.e.year}</span></span>
                <span class="sub">${esc(h.via ? `Related: ${h.via}` : h.e.task)}</span>
              </span>
              <span class="cat">${esc(h.e.cat)}</span>
            </a>
          </li>`).join('')
      : `<li class="none muted">No dataset matches “${esc(input.value.trim())}”.</li>`;
    input.setAttribute('aria-activedescendant', results.length ? `sr-${active}` : '');
  }

  function move(d: number) {
    if (!results.length) return;
    list.querySelector(`#sr-${active}`)?.setAttribute('aria-selected', 'false');
    active = (active + d + results.length) % results.length;
    const li = list.querySelector(`#sr-${active}`)!;
    li.setAttribute('aria-selected', 'true');
    li.scrollIntoView({ block: 'nearest' });
    input.setAttribute('aria-activedescendant', `sr-${active}`);
  }

  function open() {
    if (dialog.open) return;
    active = 0;
    input.value = '';
    render();
    dialog.showModal();
    input.focus();
  }

  document.querySelector('[data-search-open]')!.addEventListener('click', open);
  input.addEventListener('input', () => { active = 0; render(); });
  input.addEventListener('keydown', (ev) => {
    if (ev.key === 'ArrowDown') { ev.preventDefault(); move(1); }
    else if (ev.key === 'ArrowUp') { ev.preventDefault(); move(-1); }
    else if (ev.key === 'Enter' && results[active]) { ev.preventDefault(); location.href = results[active].href; }
  });
  list.addEventListener('mousemove', (ev) => {
    const li = (ev.target as Element).closest('li[role=option]');
    const i = li ? Number(li.id.slice(3)) : -1;
    if (i >= 0 && i !== active) move(i - active);
  });
  // Close on a click on the backdrop (outside the box).
  dialog.addEventListener('click', (ev) => { if (ev.target === dialog) dialog.close(); });

  document.addEventListener('keydown', (ev) => {
    const t = ev.target as HTMLElement;
    const typing = t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName);
    if ((ev.key === '/' && !typing && !ev.ctrlKey && !ev.metaKey && !ev.altKey) || (ev.key === 'k' && (ev.ctrlKey || ev.metaKey))) {
      ev.preventDefault();
      open();
    }
  });
</script>

<style is:global>
  .search-btn {
    display: flex; align-items: center; gap: 8px; height: 34px; padding: 0 6px 0 11px; width: 190px;
    border-radius: 999px; color: var(--muted); font-size: 0.9rem;
  }
  .search-btn .ph { flex: 1; text-align: left; }
  .search-btn kbd, dialog.search kbd {
    font: 0.75rem/1 ui-monospace, 'SF Mono', Menlo, Consolas, monospace; color: var(--muted);
    border: 1px solid var(--border); border-bottom-width: 2px; border-radius: 5px; padding: 3px 6px;
    background: var(--bg);
  }
  .search-btn kbd { border-radius: 999px; padding: 4px 8px; }
  @media (max-width: 760px) {
    .search-btn { width: 34px; padding: 0; justify-content: center; border-radius: 50%; color: var(--text); }
    .search-btn .ph, .search-btn kbd { display: none; }
  }
  @media (max-width: 420px) { .search-btn { width: 32px; height: 32px; } }

  dialog.search {
    padding: 0; border: 0; background: transparent; width: min(600px, calc(100vw - 32px));
    max-height: none; margin: 10vh auto auto; color: var(--text);
  }
  dialog.search::backdrop { background: rgb(10 10 15 / 0.35); backdrop-filter: blur(2px); }
  dialog.search .box {
    background: var(--surface); border: 1px solid var(--border); border-radius: 14px; box-shadow: var(--shadow);
    overflow: hidden; display: flex; flex-direction: column; max-height: 70vh;
  }
  dialog.search .field { display: flex; align-items: center; gap: 10px; padding: 0 14px; border-bottom: 1px solid var(--border); color: var(--muted); }
  dialog.search input {
    flex: 1; min-width: 0; border: 0; outline: 0; background: transparent; color: var(--text);
    font: inherit; font-size: 1.05rem; padding: 14px 0;
  }
  dialog.search input::-webkit-search-cancel-button { display: none; }
  dialog.search ul { list-style: none; margin: 0; padding: 6px; overflow-y: auto; overscroll-behavior: contain; }
  dialog.search li a { display: flex; align-items: center; gap: 12px; padding: 8px 10px; border-radius: 8px; color: var(--text); }
  dialog.search li a:hover { text-decoration: none; }
  dialog.search li[aria-selected='true'] a { background: color-mix(in srgb, var(--c) 10%, var(--surface)); }
  dialog.search .dot { width: 9px; height: 9px; border-radius: 50%; background: var(--c); flex: none; }
  dialog.search .txt { flex: 1; min-width: 0; display: flex; flex-direction: column; }
  dialog.search .name { font-weight: 600; }
  dialog.search .yr { font-weight: 400; color: var(--muted); font-size: 0.85rem; margin-left: 4px; }
  dialog.search .sub { font-size: 0.85rem; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  dialog.search .cat { font-size: 0.75rem; font-weight: 600; color: var(--c); flex: none; }
  dialog.search li.none { padding: 18px 12px; text-align: center; }
  dialog.search .hint { display: flex; gap: 16px; margin: 0; padding: 8px 14px; border-top: 1px solid var(--border); font-size: 0.78rem; }
  dialog.search .hint kbd { margin-right: 3px; padding: 2px 5px; }
  @media (max-width: 600px) {
    dialog.search { margin-top: 12px; }
    dialog.search .hint { display: none; }
    dialog.search .esc { display: none; }
  }
</style>
