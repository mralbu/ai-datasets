---
// "Get the data": copy-paste snippets for the full dataset (Hub CLI, 🤗 datasets, Polars).
import { Code } from 'astro:components';
import type { Dataset } from '../lib/data';
import { snippets, downloadRepo } from '../lib/snippets';
interface Props { ds: Dataset }
const { ds } = Astro.props;
const dl = ds.data.download;
const repo = downloadRepo(ds);
const tabs = snippets(ds);
const themes = { light: 'github-light', dark: 'github-dark' } as const;
---
<section class="download" data-download>
  <div class="head">
    <h2>Get the data</h2>
    <div class="controls">
      <div class="tabs" role="tablist" aria-label="Download method">
        {tabs.map((t, i) => (
          <button type="button" role="tab" id={`dl-tab-${t.id}`} aria-controls={`dl-${t.id}`} aria-selected={String(i === 0)} data-tab={t.id}>{t.label}</button>
        ))}
      </div>
      <button type="button" class="copy" data-copy aria-label="Copy snippet">Copy</button>
    </div>
  </div>
  {tabs.map((t, i) => (
    <div class="panel" role="tabpanel" id={`dl-${t.id}`} aria-labelledby={`dl-tab-${t.id}`} data-panel={t.id} data-code={t.code} hidden={i !== 0}>
      <Code code={t.code} lang={t.lang} themes={themes} />
    </div>
  ))}
  {(dl.gated || dl.note) && (
    <p class="muted note">
      {dl.gated && <><strong>Gated:</strong> log in and accept the terms on <a href={`https://huggingface.co/datasets/${repo}`}>the dataset page</a>. </>}
      {dl.note}
    </p>
  )}
</section>

<script>
  const KEY = 'download-tab';
  for (const box of document.querySelectorAll<HTMLElement>('[data-download]')) {
    const select = (id: string) => {
      box.querySelectorAll<HTMLButtonElement>('[data-tab]').forEach((b) => b.setAttribute('aria-selected', String(b.dataset.tab === id)));
      box.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => (p.hidden = p.dataset.panel !== id));
    };
    try {
      const saved = localStorage.getItem(KEY);
      if (saved && box.querySelector(`[data-tab="${saved}"]`)) select(saved);
    } catch {}
    box.querySelectorAll<HTMLButtonElement>('[data-tab]').forEach((b) =>
      b.addEventListener('click', () => {
        select(b.dataset.tab!);
        try { localStorage.setItem(KEY, b.dataset.tab!); } catch {}
      }),
    );
    box.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) =>
      b.addEventListener('click', async () => {
        const code = box.querySelector<HTMLElement>('[data-panel]:not([hidden])')?.dataset.code ?? '';
        try {
          await navigator.clipboard.writeText(code);
          b.textContent = 'Copied';
        } catch {
          b.textContent = 'Copy failed';
        }
        setTimeout(() => (b.textContent = 'Copy'), 1500);
      }),
    );
  }
</script>

<style>
  .download { margin: 0 0 1rem; min-width: 0; }
  .head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 6px; margin-bottom: 6px; }
  .controls { display: flex; align-items: center; gap: 6px; }
  h2 { margin: 0; font-size: 0.85rem; font-weight: 600; color: var(--muted); }
  .tabs { display: flex; gap: 2px; padding: 1px; border: 1px solid var(--border); border-radius: 7px; }
  .tabs button { border: 0; background: none; padding: 1px 8px; font-size: 0.75rem; border-radius: 6px; color: var(--muted); }
  .tabs button[aria-selected='true'] { background: var(--accent-soft); color: var(--text); }
  .panel :global(pre) { margin: 0; font-size: 0.74rem; line-height: 1.45; padding: 8px 12px; white-space: pre; border: 1px solid var(--border); }
  .copy { font-size: 0.75rem; padding: 1px 9px; line-height: 1.5; }
  .note { font-size: 0.74rem; margin: 6px 0 0; }
</style>
