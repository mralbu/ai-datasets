---
interface Props { spec: Record<string, unknown> }
const { spec } = Astro.props;
---
<figure class="chart card" data-spec={JSON.stringify(spec)}></figure>
<script>
  import embed from 'vega-embed';
  const isDark = () => {
    const t = document.documentElement.dataset.theme;
    return t ? t === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
  };
  const render = () => {
    for (const el of document.querySelectorAll<HTMLElement>('figure.chart')) {
      const spec = JSON.parse(el.dataset.spec!);
      spec.background = 'transparent';
      embed(el, spec, { actions: false, theme: isDark() ? 'dark' : undefined, renderer: 'svg' });
    }
  };
  render();
  window.addEventListener('themechange', render);
  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', render);
</script>
<style>
  .chart { margin: 0; padding: 16px; width: 100%; }
</style>
