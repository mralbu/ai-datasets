---
// Time series: a grid of small line charts, one per sampled series (Chronos / GIFT-Eval / UCR
// layout), or, for a window of consecutive rows (source.window), one stacked chart per column.
import type { Samples, SampleRow } from '../../lib/data';
import type { Display } from '../../lib/data';
import { seriesOf } from '../../lib/series';
import SeriesPlot from '../SeriesPlot.astro';
interface Props { s: Samples; d: Extract<Display, { kind: 'series' }>; rows: SampleRow[]; k: number; notes?: Record<string, string> }
const { s, d, k, notes = {} } = Astro.props;
const all = seriesOf(s, d);
const window = !!s.window;
const single = window && all.length === 1;
const n = (x: number) => x.toLocaleString('en-US');
---
<div class:list={['series', { window, single }]}>
  {all.map((sr, i) => (
    <article class="card" data-item hidden={i >= k}>
      {(sr.title || sr.tags.length > 0) && (
        <header>
          {sr.title && <span class="title">{sr.title}</span>}
          {sr.tags.map((t) => <span class="tag" data-m="timeseries" title={notes[t]}>{t}</span>)}
        </header>
      )}
      <SeriesPlot sr={sr} height={single ? 260 : window ? 96 : 120} />
      {sr.points && (
        <p class="cut muted">
          {sr.points.from + (sr.channels[0]?.length ?? 0) >= sr.points.total ? 'the last' : 'a stretch of'}{' '}
          {n(sr.channels[0]?.length ?? 0)} of {n(sr.points.total)} points{d.future && <> of history</>}
        </p>
      )}
    </article>
  ))}
</div>
<style>
  .series { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); gap: 14px; }
  .series.window { grid-template-columns: minmax(0, 1fr); gap: 10px; }
  .series > [hidden] { display: none; }
  article { padding: 12px 16px 10px 10px; min-width: 0; }
  header { display: flex; align-items: center; gap: 6px; margin: 0 0 10px 44px; min-height: 1.4em; min-width: 0; }
  header .tag { flex: none; }
  .title { font-family: ui-monospace, 'SF Mono', Menlo, monospace; font-size: 0.8rem; font-weight: 600; margin-right: 4px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; flex: 0 1 auto; }
  .window .title { font-family: inherit; font-size: 0.85rem; }
  .cut { margin: 4px 0 0 44px; font-size: 0.7rem; }
</style>
