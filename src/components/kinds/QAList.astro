---
import 'katex/dist/katex.min.css';
import { renderMath } from '../../lib/math';
import type { SampleRow } from '../../lib/data';
interface Props { d: { question: string; answer: string; tags: string[]; math: boolean; input?: string; verdict?: string; wrong?: string; answer_label: string }; rows: SampleRow[]; k: number }
const { d, rows, k } = Astro.props;
// GSM8K-style answers: highlight <<calc>> annotations and the final "#### n" line.
const segments = (t: string) => t.split(/(<<[^>]*>>|^####.*$)/m).filter(Boolean);
// A list-valued field (AIME's problem types, IFEval's instruction ids) becomes one tag or item per entry.
const list = (v: unknown): string[] => (Array.isArray(v) ? v.map(String) : v == null || v === '' ? [] : [String(v)]);
---
<div class="list">
  {rows.map((r, i) => (
    <article class="card" data-item hidden={i >= k}>
      {d.tags.length > 0 && <p class="tags">{d.tags.flatMap((t) => list(r.row[t])).map((t) => <span class="tag">{t}</span>)}</p>}
      {d.math ? <p class="q pre" set:html={renderMath(String(r.row[d.question]))} /> : <p class="q">{r.row[d.question]}</p>}
      {d.input && r.row[d.input] && (typeof r.row[d.input] === 'object' && r.row[d.input].contexts ? (
        <div class="input sections">
          {(r.row[d.input].contexts as string[]).map((c, j) => (
            <p>{r.row[d.input].labels?.[j] && <span class="sec">{String(r.row[d.input].labels[j]).toLowerCase()}</span>}{c}</p>
          ))}
        </div>
      ) : <p class="input pre">{r.row[d.input]}</p>)}
      <details>
        <summary>{d.answer_label}</summary>
        {d.verdict && r.row[d.verdict] && <p class="verdict"><span class="tag">{r.row[d.verdict]}</span></p>}
        {Array.isArray(r.row[d.answer]) ? <ul class="items">{list(r.row[d.answer]).map((a) => <li><code>{a}</code></li>)}</ul> :
         d.math ? <p class="pre" set:html={renderMath(String(r.row[d.answer]))} /> : (
          <p class="pre">
            {segments(String(r.row[d.answer])).map((seg) =>
              seg.startsWith('<<') ? <mark class="calc">{seg}</mark> : seg.startsWith('####') ? <strong class="final">{seg}</strong> : seg,
            )}
          </p>
        )}
        {d.wrong && (r.row[d.wrong] as string[])?.length > 0 && (
          <div class="wrong">
            <p class="muted">Answers a model gets marked wrong for:</p>
            <ul>{(r.row[d.wrong] as string[]).map((w) => <li>{w}</li>)}</ul>
          </div>
        )}
      </details>
    </article>
  ))}
</div>
<style>
  mark.calc { background: var(--code-bg); color: var(--muted); font-family: ui-monospace, Menlo, monospace; font-size: 0.85em; padding: 0 2px; border-radius: 3px; }
  .final { color: var(--pos); }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; margin: 0 0 8px; }
  .items { margin: 6px 0 0; padding-left: 20px; font-size: 0.9rem; }
  .input { margin: -4px 0 10px; padding: 8px 12px; border-left: 3px solid var(--border); color: var(--muted); font-size: 0.92rem; }
  .sections p { margin: 0 0 6px; }
  .sections p:last-child { margin: 0; }
  .sec { display: inline-block; margin-right: 6px; font-size: 0.7rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: var(--text); }
  .verdict { margin: 8px 0 4px; }
  .verdict .tag { font-size: 0.85rem; text-transform: capitalize; }
  .wrong { margin-top: 10px; font-size: 0.92rem; }
  .wrong p { margin: 0 0 4px; font-size: 0.85rem; }
  .wrong ul { margin: 0; padding-left: 20px; color: var(--neg); }
  article :global(.katex-display) { overflow-x: auto; overflow-y: hidden; padding: 2px 0; }
  article :global(.asy) { color: var(--muted); font-style: italic; font-size: 0.88em; }
  /* \boxed{} answers: tint the box like the GSM8K final answer. */
  article :global(.katex .boxpad) { color: var(--pos); }
</style>
