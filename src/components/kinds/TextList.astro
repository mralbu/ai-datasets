---
import { labelOf, type Samples, type SampleRow } from '../../lib/data';
interface Props { s: Samples; d: { text: string; label?: string; summary?: string; caption?: string }; rows: SampleRow[]; k: number }
const { s, d, rows, k } = Astro.props;
const clean = (t: string) => t.replace(/<br\s*\/?>/g, '\n');
---
<div class="list">
  {rows.map((r, i) => {
    const label = d.label ? labelOf(s, d.label, r.row[d.label], r) : undefined;
    return (
      <article class="card text" data-item hidden={i >= k}>
        {label && <span class:list={['label', label]}>{label}</span>}
        <p class="clamp">{clean(String(r.row[d.text]))}</p>
        <button type="button" class="more" data-more>Show all</button>
        {d.summary && (
          <details>
            <summary>Reference summary</summary>
            <p class="pre summary">{String(r.row[d.summary])}</p>
          </details>
        )}
        {d.caption && <p class="muted caption">{r.row[d.caption]}</p>}
      </article>
    );
  })}
</div>
<style>
  details { margin-top: 10px; }
  .summary { margin: 6px 0 0; font-weight: 500; }
  .caption { font-size: 0.78rem; margin: 8px 0 0; overflow-wrap: anywhere; }
</style>
