---
import { classNames, url, type Samples, type SampleRow } from '../../lib/data';
interface Props { s: Samples; d: { image: string; objects: string }; rows: SampleRow[]; k: number }
const { s, d, rows, k } = Astro.props;
const names = classNames(s, d.objects);
const palette = ['#e6194b', '#3cb44b', '#4363d8', '#f58231', '#911eb4', '#42d4f4', '#f032e6', '#bfef45', '#fabed4', '#469990', '#dcbeff', '#9a6324'];
const color = (id: number) => palette[id % palette.length];
const counts = (labels: number[]) => {
  const m = new Map<string, number>();
  for (const l of labels) m.set(names[l] ?? String(l), (m.get(names[l] ?? String(l)) ?? 0) + 1);
  return [...m.entries()].sort((a, b) => b[1] - a[1]);
};
---
<div class="boxes-grid">
  {rows.map((r, i) => {
    const img = r.row[d.image];
    const o = r.row[d.objects];
    return (
      <figure class="card" data-item hidden={i >= k}>
        <div class="frame">
          <img src={url(img.src)} width={img.width} height={img.height} alt="" loading="lazy" />
          <svg viewBox={`0 0 ${img.width} ${img.height}`} preserveAspectRatio="none" aria-hidden="true">
            {o.bbox.map(([x, y, w, h]: number[], j: number) => (
              <g style={`--c:${color(o.label[j])}`}>
                <rect x={x} y={y} width={w} height={h} />
                <text x={x + 3} y={y + 14}>{names[o.label[j]]}</text>
              </g>
            ))}
          </svg>
        </div>
        <figcaption>
          {counts(o.label).map(([n, c]) => <span class="obj">{n}{c > 1 && <span class="muted"> ×{c}</span>}</span>)}
        </figcaption>
      </figure>
    );
  })}
</div>
<style>
  .boxes-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 14px; align-items: start; }
  figure { margin: 0; overflow: hidden; }
  figure[hidden] { display: none; }
  .frame { position: relative; line-height: 0; }
  .frame img { width: 100%; height: auto; display: block; }
  svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  rect { fill: none; stroke: var(--c); stroke-width: 3; vector-effect: non-scaling-stroke; }
  text { fill: #fff; font: 600 13px system-ui, sans-serif; paint-order: stroke; stroke: var(--c); stroke-width: 4px; }
  :global(.no-boxes) svg { display: none; }
  figcaption { display: flex; flex-wrap: wrap; gap: 4px 10px; padding: 10px 12px; font-size: 0.82rem; }
</style>
