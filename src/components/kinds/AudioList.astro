---
import { url, type SampleRow } from '../../lib/data';
interface Props { d: { audio: string; text: string; speaker?: string }; rows: SampleRow[]; k: number }
const { d, rows, k } = Astro.props;
---
<div class="list">
  {rows.map((r, i) => (
    <article class="card" data-item hidden={i >= k}>
      <audio controls preload="none" src={url(r.row[d.audio].src)}></audio>
      <p class="transcript">{r.row[d.text]}</p>
      {d.speaker && <p class="muted small">speaker {r.row[d.speaker]}</p>}
    </article>
  ))}
</div>
<style>
  audio { width: 100%; }
  .transcript { font-family: ui-monospace, Menlo, monospace; font-size: 0.85rem; margin: 10px 0 0; letter-spacing: 0.02em; }
  .small { font-size: 0.8rem; margin: 6px 0 0; }
</style>
