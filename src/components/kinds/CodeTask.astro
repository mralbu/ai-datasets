---
import { Code } from 'astro:components';
import type { SampleRow } from '../../lib/data';
interface Props {
  d: {
    prompt: string; solution: string; tests?: string; title?: string;
    prompt_lang: string; solution_lang: string; tests_lang: string;
    prompt_label: string; solution_label: string; tests_label: string;
  };
  rows: SampleRow[];
  k: number;
}
const { d, rows, k } = Astro.props;
const themes = { light: 'github-light', dark: 'github-dark' } as const;
---
<div class="list">
  {rows.map((r, i) => (
    <article class="card" data-item hidden={i >= k}>
      {d.title && <span class="tag">{r.row[d.title]}</span>}
      <p class="muted small">{d.prompt_label}</p>
      {d.prompt_lang === 'text' ? (
        <>
          <p class="clamp prose">{String(r.row[d.prompt]).trim()}</p>
          <button type="button" class="more" data-more>Show all</button>
        </>
      ) : (
        <Code code={String(r.row[d.prompt]).replace(/^\s*\n/, '').trimEnd()} lang={d.prompt_lang as any} themes={themes} />
      )}
      <details>
        <summary>{d.solution_label}</summary>
        <Code code={String(r.row[d.solution]).replace(/\s+$/, '')} lang={d.solution_lang as any} themes={themes} />
      </details>
      {d.tests && (
        <details>
          <summary>{d.tests_label}</summary>
          <Code code={String(r.row[d.tests]).trim()} lang={d.tests_lang as any} themes={themes} />
        </details>
      )}
    </article>
  ))}
</div>
<style>
  .tag { margin-bottom: 6px; }
  .small { font-size: 0.82rem; margin: 8px 0 4px; }
  details { margin-top: 8px; }
  article :global(pre) { margin: 6px 0; font-size: 0.82rem; max-height: 480px; }
  .prose { overflow-wrap: anywhere; font-size: 0.92rem; }
  .prose + .more { display: block; }
</style>
