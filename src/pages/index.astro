---
import Base from '../layouts/Base.astro';
import DatasetCard from '../components/DatasetCard.astro';
import CategoryFilter from '../components/CategoryFilter.astro';
import { getDatasets, MODALITIES, TAGS, url } from '../lib/data';
const FOLD_LIMIT = 6;
const all = await getDatasets();
const groups = Object.keys(MODALITIES)
  .map((m) => ({ m, items: all.filter((d) => d.data.modality === m) }))
  .filter((g) => g.items.length);
const counts = Object.fromEntries(groups.map((g) => [g.m, g.items.length]));
---
<Base title="AI Datasets">
  <section class="hero">
    <h1>What do famous AI datasets actually look like?</h1>
    <p class="muted">
      A small, curated collection of datasets and benchmarks that shaped AI. Each entry
      has the key facts, why it matters, and real samples you can shuffle through.
    </p>
    <p class="tag-banner" data-tag-banner data-names={JSON.stringify(TAGS)} hidden>
      Showing datasets tagged <strong data-tag-name></strong>. <a href={url('/')}>Show all</a>
    </p>
  </section>

  <CategoryFilter counts={counts} />

  {groups.map(({ m, items }) => {
    const extra = items.length - FOLD_LIMIT;
    return (
      <section data-filter-item data-m={m} data-group data-fold-section={extra > 0 ? m : undefined}>
        <h2><span class="cat-dot" aria-hidden="true"></span>{MODALITIES[m]}</h2>
        <div class="cards">
          {items.map((ds, i) => (
            <div class="card-slot" data-extra={i >= FOLD_LIMIT ? '' : undefined}>
              <DatasetCard ds={ds} />
            </div>
          ))}
        </div>
        {extra > 0 && (
          <div class="fold-bar">
            <button
              type="button"
              class="fold-btn"
              data-fold-toggle
              aria-expanded="false"
              aria-label={`Show all ${items.length} ${MODALITIES[m]} datasets`}
              data-more={`+${extra} more ▾`}
              data-less="Show less ▴"
              data-label-more={`Show all ${items.length} ${MODALITIES[m]} datasets`}
              data-label-less={`Show fewer ${MODALITIES[m]} datasets`}
            >
              +{extra} more ▾
            </button>
          </div>
        )}
      </section>
    );
  })}
</Base>

<script>
  // ?tag=medical shows only the entries with that tag (links from tag pills on dataset pages).
  const tag = new URLSearchParams(location.search).get('tag');
  const banner = document.querySelector<HTMLElement>('[data-tag-banner]');
  const names: Record<string, string> = JSON.parse(banner?.dataset.names ?? '{}');
  if (tag && banner && names[tag]) {
    banner.hidden = false;
    banner.querySelector('[data-tag-name]')!.textContent = names[tag];
    for (const g of document.querySelectorAll<HTMLElement>('[data-group]')) {
      let any = false;
      for (const slot of g.querySelectorAll<HTMLElement>('.card-slot')) {
        const entry = slot.querySelector<HTMLElement>('.entry');
        const on = (entry?.dataset.tags ?? '').split(' ').includes(tag);
        slot.classList.toggle('off-tag', !on);
        any ||= on;
      }
      g.classList.toggle('off-tag', !any);
      // Show all matching tagged datasets without requiring an extra click.
      g.classList.add('expanded');
      const bar = g.querySelector<HTMLElement>('.fold-bar');
      if (bar) bar.hidden = true;
    }
  }

  // Per-category foldable limit (6 cards initially, expandable with the bottom button).
  for (const sec of document.querySelectorAll<HTMLElement>('[data-fold-section]')) {
    const btn = sec.querySelector<HTMLButtonElement>('[data-fold-toggle]')!;
    btn.addEventListener('click', () => {
      const open = sec.classList.toggle('expanded');
      btn.setAttribute('aria-expanded', String(open));
      btn.textContent = open ? btn.dataset.less! : btn.dataset.more!;
      btn.setAttribute('aria-label', open ? btn.dataset.labelLess! : btn.dataset.labelMore!);
    });
  }
</script>

<style>
  .hero { padding: 40px 0 8px; max-width: 680px; }
  .hero h1 { font-size: clamp(1.7rem, 4vw, 2.4rem); margin: 0 0 12px; }
  section[hidden], [hidden] { display: none !important; }
  h2 { scroll-margin-top: 120px; }
  .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 16px; }
  .card-slot { display: flex; }
  .card-slot > :global(.card) { width: 100%; }
  [data-fold-section]:not(.expanded) .card-slot[data-extra] { display: none; }

  .fold-bar { display: flex; align-items: center; gap: 12px; margin-top: 16px; }
  .fold-bar::before, .fold-bar::after { content: ''; flex: 1; height: 1px; background: var(--border); }
  .fold-btn {
    border: 0; background: none; padding: 2px 6px; border-radius: 4px;
    font-size: 0.82rem; font-weight: 500; color: var(--muted);
    transition: color 0.15s;
  }
  .fold-btn:hover { color: var(--c, var(--accent)); }
  .fold-btn:focus-visible { outline: 2px solid var(--c, var(--accent)); outline-offset: 2px; }

  .tag-banner { margin: 10px 0 0; font-size: 0.9rem; }
  .tag-banner[hidden] { display: none; }
  :global(.off-tag) { display: none !important; }
</style>
