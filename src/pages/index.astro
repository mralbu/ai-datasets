---
import Base from '../layouts/Base.astro';
import Preview from '../components/Preview.astro';
import { getDatasets, MODALITIES, url } from '../lib/data';
const all = await getDatasets();
const groups = Object.keys(MODALITIES)
  .map((m) => ({ m, items: all.filter((d) => d.data.modality === m) }))
  .filter((g) => g.items.length);
---
<Base title="AI Datasets">
  <section class="hero">
    <h1>What do famous AI datasets actually look like?</h1>
    <p class="muted">
      A small, curated collection of datasets and benchmarks that shaped AI. Each entry
      has the key facts, why it matters, and real samples you can shuffle through.
    </p>
  </section>

  <div class="chips" role="group" aria-label="Show categories">
    <button type="button" class="chip" data-all aria-pressed="true">All<span class="n">{all.length}</span></button>
    {groups.map(({ m, items }) => (
      <button type="button" class="chip" data-toggle={m} aria-pressed="true">{MODALITIES[m]}<span class="n">{items.length}</span></button>
    ))}
  </div>

  {groups.map(({ m, items }) => (
    <section data-group={m}>
      <h2>{MODALITIES[m]}</h2>
      <div class="cards">
        {items.map((ds) => (
          <a class="card entry" href={url(`/d/${ds.id}`)}>
            <div class="top">
              <h3>{ds.data.name}</h3>
              <span class="year">{ds.data.year}</span>
            </div>
            <p class="one">{ds.data.one_liner}</p>
            <Preview ds={ds} />
          </a>
        ))}
      </div>
    </section>
  ))}
  <p class="muted empty" data-empty hidden>No categories selected. <button type="button" class="linkish" data-reset>Show all</button></p>
</Base>

<script>
  // Each chip toggles its category on or off; "All" turns everything back on.
  // The selection is kept in the URL (#vision,text) so it can be shared.
  const toggles = [...document.querySelectorAll<HTMLButtonElement>('[data-toggle]')];
  const allChip = document.querySelector<HTMLButtonElement>('[data-all]')!;
  const groups = [...document.querySelectorAll<HTMLElement>('[data-group]')];
  const empty = document.querySelector<HTMLElement>('[data-empty]')!;
  const keys = toggles.map((t) => t.dataset.toggle!);

  const apply = (on: Set<string>) => {
    toggles.forEach((t) => t.setAttribute('aria-pressed', String(on.has(t.dataset.toggle!))));
    groups.forEach((g) => (g.hidden = !on.has(g.dataset.group!)));
    allChip.setAttribute('aria-pressed', String(on.size === keys.length));
    empty.hidden = on.size > 0;
    const hash = on.size === keys.length ? '' : `#${[...on].join(',')}`;
    history.replaceState(null, '', location.pathname + hash);
  };
  const current = () => new Set(toggles.filter((t) => t.getAttribute('aria-pressed') === 'true').map((t) => t.dataset.toggle!));

  toggles.forEach((t) =>
    t.addEventListener('click', () => {
      const on = current();
      const k = t.dataset.toggle!;
      on.has(k) ? on.delete(k) : on.add(k);
      apply(on);
    }),
  );
  const showAll = () => apply(new Set(keys));
  allChip.addEventListener('click', showAll);
  document.querySelector('[data-reset]')!.addEventListener('click', showAll);

  const fromHash = location.hash.slice(1).split(',').filter((k) => keys.includes(k));
  if (fromHash.length) apply(new Set(fromHash));
</script>

<style>
  .hero { padding: 40px 0 8px; max-width: 680px; }
  .hero h1 { font-size: clamp(1.7rem, 4vw, 2.4rem); margin: 0 0 12px; }
  .chips { margin: 20px 0 4px; }
  section[hidden] { display: none; }
  .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 16px; }
  .entry { display: flex; flex-direction: column; gap: 10px; padding: 16px; color: var(--text); transition: border-color 0.15s; }
  .entry:hover { border-color: var(--accent); text-decoration: none; }
  .top { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; }
  h3 { margin: 0; font-size: 1.05rem; }
  .year { color: var(--muted); font-variant-numeric: tabular-nums; font-size: 0.9rem; }
  .one { margin: 0; font-size: 0.92rem; }
  .empty { margin-top: 32px; }
  .linkish { border: 0; background: none; padding: 0; color: var(--accent); font: inherit; cursor: pointer; }
  .linkish:hover { text-decoration: underline; }
</style>
