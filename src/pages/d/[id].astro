---
import Base from '../../layouts/Base.astro';
import Samples from '../../components/Samples.astro';
import Chart from '../../components/Chart.astro';
import { getDatasets, getSamples, MODALITIES, url } from '../../lib/data';

export async function getStaticPaths() {
  const all = await getDatasets();
  return all.map((ds, i) => ({ params: { id: ds.id }, props: { ds, prev: all[i - 1], next: all[i + 1] } }));
}
const { ds, prev, next } = Astro.props;
const d = ds.data;
const s = getSamples(ds.id);
const splits = Object.entries(d.splits).map(([k, v]) => `${k} ${v.toLocaleString('en-US')}`).join(' · ');
const facts: [string, string][] = [
  ['Year', String(d.year)],
  ['Creators', d.creators],
  ['Task', d.task],
  ['Size', d.size],
  ['Splits', splits],
  ['Input', d.input],
  ['Labels', d.labels],
  ['License', d.license],
];
---
<Base title={`${d.name} · AI Datasets`} description={d.one_liner}>
  <p class="crumb"><a href={url('/')}>Catalog</a> / <span class="tag">{MODALITIES[d.modality]}</span></p>
  <h1>{d.name} <span class="muted">({d.year})</span></h1>
  <p class="lede">{d.one_liner}</p>

  <div class="top">
    <section class="why">
      <h2>Why it matters</h2>
      <p>{d.why}</p>
      <p class="links">
        {d.paper && <a href={d.paper.url}>Paper: {d.paper.title}</a>}
        {d.homepage && <a href={d.homepage}>Homepage</a>}
        <a href={`https://huggingface.co/datasets/${d.source.hf}`}>On Hugging Face</a>
      </p>
    </section>
    <dl class="facts card">
      {facts.map(([k, v]) => (<><dt>{k}</dt><dd>{v}</dd></>))}
    </dl>
  </div>

  <h2>Samples</h2>
  {s ? <Samples ds={ds} samples={s} /> : (
    <p class="muted card empty">Samples have not been fetched. Run <code>npm run fetch</code>, then rebuild.</p>
  )}

  {s?.chart && (<><h2>The whole dataset at once</h2><Chart spec={s.chart} /></>)}

  {d.trivia.length > 0 && (
    <>
      <h2>Worth knowing</h2>
      <ul class="trivia">{d.trivia.map((t) => <li>{t}</li>)}</ul>
    </>
  )}

  <div class="cols">
    {d.lineage.length > 0 && (
      <section>
        <h2>Related datasets</h2>
        <ul>{d.lineage.map((l) => <li><strong>{l.name}</strong>{l.note && <span class="muted">: {l.note}</span>}</li>)}</ul>
      </section>
    )}
    {d.landmark_papers.length > 0 && (
      <section>
        <h2>Landmark papers</h2>
        <ul>{d.landmark_papers.map((p) => <li><a href={p.url}>{p.title}</a> <span class="muted">({p.year})</span></li>)}</ul>
      </section>
    )}
  </div>

  <nav class="pager">
    {prev ? <a href={url(`/d/${prev.id}`)}>← {prev.data.name} ({prev.data.year})</a> : <span />}
    {next ? <a href={url(`/d/${next.id}`)}>{next.data.name} ({next.data.year}) →</a> : <span />}
  </nav>
</Base>
<style>
  .crumb { margin: 24px 0 0; font-size: 0.9rem; }
  h1 { margin: 8px 0 6px; font-size: clamp(1.6rem, 4vw, 2.2rem); }
  h1 .muted { font-weight: 400; }
  .lede { font-size: 1.1rem; margin: 0 0 8px; }
  .top { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 28px; align-items: start; }
  @media (max-width: 760px) { .top { grid-template-columns: 1fr; } }
  .links { display: flex; flex-wrap: wrap; gap: 6px 18px; font-size: 0.92rem; }
  .facts { display: grid; grid-template-columns: auto 1fr; gap: 6px 14px; padding: 16px 18px; margin: 2.2rem 0 0; font-size: 0.9rem; }
  dt { color: var(--muted); }
  dd { margin: 0; }
  .empty { padding: 16px; }
  .trivia li { margin-bottom: 6px; }
  .cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 0 28px; }
  .pager { display: flex; justify-content: space-between; gap: 16px; margin-top: 40px; padding-top: 16px; border-top: 1px solid var(--border); font-size: 0.92rem; }
</style>
