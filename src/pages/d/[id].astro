---
import Base from '../../layouts/Base.astro';
import Samples from '../../components/Samples.astro';
import Chart from '../../components/Chart.astro';
import Download from '../../components/Download.astro';
import { getDatasets, getSamples, MODALITIES, url } from '../../lib/data';

export async function getStaticPaths() {
  const all = await getDatasets();
  return all.map((ds, i) => ({ params: { id: ds.id }, props: { ds, prev: all[i - 1], next: all[i + 1] } }));
}
const { ds, prev, next } = Astro.props;
const byId = new Map((await getDatasets()).map((x) => [x.id, x]));
const hfUrl = (id: string) => `https://huggingface.co/datasets/${id}`;
const hostOf = (u: string) => new URL(u).hostname.replace(/^www\./, '');
const d = ds.data;
const s = getSamples(ds.id);
const splits = Object.entries(d.splits).map(([k, v]) => `${k} ${v.toLocaleString('en-US')}`).join(' · ');
// Icons (24×24) for the link buttons: line icons are stroked; the Hugging Face mark
// (Simple Icons, CC0) is filled.
const HF_LOGO = 'M12.025 1.13c-5.77 0-10.449 4.647-10.449 10.378 0 1.112.178 2.181.503 3.185.064-.222.203-.444.416-.577a.96.96 0 0 1 .524-.15c.293 0 .584.124.84.284.278.173.48.408.71.694.226.282.458.611.684.951v-.014c.017-.324.106-.622.264-.874s.403-.487.762-.543c.3-.047.596.06.787.203s.31.313.4.467c.15.257.212.468.233.542.01.026.653 1.552 1.657 2.54.616.605 1.01 1.223 1.082 1.912.055.537-.096 1.059-.38 1.572.637.121 1.294.187 1.967.187.657 0 1.298-.063 1.921-.178-.287-.517-.44-1.041-.384-1.581.07-.69.465-1.307 1.081-1.913 1.004-.987 1.647-2.513 1.657-2.539.021-.074.083-.285.233-.542.09-.154.208-.323.4-.467a1.08 1.08 0 0 1 .787-.203c.359.056.604.29.762.543s.247.55.265.874v.015c.225-.34.457-.67.683-.952.23-.286.432-.52.71-.694.257-.16.547-.284.84-.285a.97.97 0 0 1 .524.151c.228.143.373.388.43.625l.006.04a10.3 10.3 0 0 0 .534-3.273c0-5.731-4.678-10.378-10.449-10.378M8.327 6.583a1.5 1.5 0 0 1 .713.174 1.487 1.487 0 0 1 .617 2.013c-.183.343-.762-.214-1.102-.094-.38.134-.532.914-.917.71a1.487 1.487 0 0 1 .69-2.803m7.486 0a1.487 1.487 0 0 1 .689 2.803c-.385.204-.536-.576-.916-.71-.34-.12-.92.437-1.103.094a1.487 1.487 0 0 1 .617-2.013 1.5 1.5 0 0 1 .713-.174m-10.68 1.55a.96.96 0 1 1 0 1.921.96.96 0 0 1 0-1.92m13.838 0a.96.96 0 1 1 0 1.92.96.96 0 0 1 0-1.92M8.489 11.458c.588.01 1.965 1.157 3.572 1.164 1.607-.007 2.984-1.155 3.572-1.164.196-.003.305.12.305.454 0 .886-.424 2.328-1.563 3.202-.22-.756-1.396-1.366-1.63-1.32q-.011.001-.02.006l-.044.026-.01.008-.03.024q-.018.017-.035.036l-.032.04a1 1 0 0 0-.058.09l-.014.025q-.049.088-.11.19a1 1 0 0 1-.083.116 1.2 1.2 0 0 1-.173.18q-.035.029-.075.058a1.3 1.3 0 0 1-.251-.243 1 1 0 0 1-.076-.107c-.124-.193-.177-.363-.337-.444-.034-.016-.104-.008-.2.022q-.094.03-.216.087-.06.028-.125.063l-.13.074q-.067.04-.136.086a3 3 0 0 0-.135.096 3 3 0 0 0-.26.219 2 2 0 0 0-.12.121 2 2 0 0 0-.106.128l-.002.002a2 2 0 0 0-.09.132l-.001.001a1.2 1.2 0 0 0-.105.212q-.013.036-.024.073c-1.139-.875-1.563-2.317-1.563-3.203 0-.334.109-.457.305-.454m.836 10.354c.824-1.19.766-2.082-.365-3.194-1.13-1.112-1.789-2.738-1.789-2.738s-.246-.945-.806-.858-.97 1.499.202 2.362c1.173.864-.233 1.45-.685.64-.45-.812-1.683-2.896-2.322-3.295s-1.089-.175-.938.647 2.822 2.813 2.562 3.244-1.176-.506-1.176-.506-2.866-2.567-3.49-1.898.473 1.23 2.037 2.16c1.564.932 1.686 1.178 1.464 1.53s-3.675-2.511-4-1.297c-.323 1.214 3.524 1.567 3.287 2.405-.238.839-2.71-1.587-3.216-.642-.506.946 3.49 2.056 3.522 2.064 1.29.33 4.568 1.028 5.713-.624m5.349 0c-.824-1.19-.766-2.082.365-3.194 1.13-1.112 1.789-2.738 1.789-2.738s.246-.945.806-.858.97 1.499-.202 2.362c-1.173.864.233 1.45.685.64.451-.812 1.683-2.896 2.322-3.295s1.089-.175.938.647-2.822 2.813-2.562 3.244 1.176-.506 1.176-.506 2.866-2.567 3.49-1.898-.473 1.23-2.037 2.16c-1.564.932-1.686 1.178-1.464 1.53s3.675-2.511 4-1.297c.323 1.214-3.524 1.567-3.287 2.405.238.839 2.71-1.587 3.216-.642.506.946-3.49 2.056-3.522 2.064-1.29.33-4.568 1.028-5.713-.624';
const ICONS = {
  home: 'M3 10.5 12 3l9 7.5M5 9v11a1 1 0 0 0 1 1h4v-6h4v6h4a1 1 0 0 0 1-1V9',
  paper: 'M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8l-5-5Zm0 0v5h5M9 13h6M9 17h6',
};
const links = [
  d.homepage && { href: d.homepage, label: 'Homepage', icon: ICONS.home, tip: hostOf(d.homepage) },
  { href: hfUrl(d.source.hf), label: 'Hugging Face', icon: HF_LOGO, tip: d.source.hf, filled: true },
  d.paper && { href: d.paper.url, label: 'Paper', icon: ICONS.paper, tip: hostOf(d.paper.url) },
].filter(Boolean) as { href: string; label: string; icon: string; tip: string; filled?: boolean }[];
const facts: [string, string][] = [
  ['Year', String(d.year)],
  ['Creators', d.creators],
  ['Task', d.task],
  ['Size', d.size],
  ['Splits', splits],
  ['Input', d.input],
  ['Labels', d.labels],
  ['License', d.license],
];
---
<Base title={`${d.name} · AI Datasets`} description={d.one_liner}>
  <p class="crumb"><a href={url('/')}>Catalog</a> / <span class="tag" data-m={d.modality}>{MODALITIES[d.modality]}</span></p>
  <h1>{d.name} <span class="muted">({d.year})</span></h1>
  <p class="lede">{d.one_liner}</p>

  <div class="top">
    <section class="why">
      <h2>Why it matters</h2>
      <p>{d.why}</p>
      <div class="links icon-links">
        {links.map((l) => (
          <a class="link-btn tip" href={l.href} data-tip={l.tip}>
            <svg class:list={{ filled: l.filled }} viewBox="0 0 24 24" aria-hidden="true"><path d={l.icon} /></svg>{l.label}
          </a>
        ))}
      </div>
      <Download ds={ds} />
    </section>
    <dl class="facts card">
      {facts.map(([k, v]) => (<><dt>{k}</dt><dd>{v}</dd></>))}
      {d.paper && (<><dt>Paper</dt><dd><a href={d.paper.url}>{d.paper.title}</a></dd></>)}
    </dl>
  </div>

  <h2>Samples</h2>
  {s ? <Samples ds={ds} samples={s} /> : (
    <p class="muted card empty">Samples have not been fetched. Run <code>npm run fetch</code>, then rebuild.</p>
  )}

  {s?.chart && (<><h2>The whole dataset at once</h2><Chart spec={s.chart} /></>)}

  {d.trivia.length > 0 && (
    <>
      <h2>Worth knowing</h2>
      <ul class="trivia">{d.trivia.map((t) => <li>{t}</li>)}</ul>
    </>
  )}

  <div class="cols">
    {d.lineage.length > 0 && (
      <section>
        <h2>Related datasets</h2>
        <ul class="lineage">
          {d.lineage.map((l) => {
            const href = l.hf ? hfUrl(l.hf) : l.url;
            const here = l.id ? byId.get(l.id) : undefined;
            return (
              <li>
                {href ? <a href={href}><strong>{l.name}</strong></a> : <strong>{l.name}</strong>}
                {l.note && <span class="muted">: {l.note}</span>}
                {href && <span class="where">{l.hf ? 'Hugging Face' : hostOf(href)} ↗</span>}
                {here && <a class="here" href={url(`/d/${here.id}`)}>{here.data.name} on this site →</a>}
              </li>
            );
          })}
        </ul>
      </section>
    )}
    {d.landmark_papers.length > 0 && (
      <section>
        <h2>Landmark papers</h2>
        <ul>{d.landmark_papers.map((p) => <li><a href={p.url}>{p.title}</a> <span class="muted">({p.year})</span></li>)}</ul>
      </section>
    )}
  </div>

  <nav class="pager">
    {prev ? <a href={url(`/d/${prev.id}`)}>← {prev.data.name} ({prev.data.year})</a> : <span />}
    {next ? <a href={url(`/d/${next.id}`)}>{next.data.name} ({next.data.year}) →</a> : <span />}
  </nav>
</Base>
<style>
  .crumb { margin: 24px 0 0; font-size: 0.9rem; }
  h1 { margin: 8px 0 6px; font-size: clamp(1.6rem, 4vw, 2.2rem); }
  h1 .muted { font-weight: 400; }
  .lede { font-size: 1.1rem; margin: 0 0 8px; }
  .top { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 28px; align-items: start; }
  @media (max-width: 760px) { .top { grid-template-columns: minmax(0, 1fr); gap: 8px; } .facts { margin-top: 0 !important; } }
  .links { display: flex; flex-wrap: wrap; gap: 8px; margin: 4px 0 1.25rem; }
  .link-btn {
    display: inline-flex; align-items: center; gap: 7px; height: 32px; padding: 0 12px;
    border: 1px solid var(--border); border-radius: 8px; background: var(--surface);
    color: var(--text); font-size: 0.85rem; font-weight: 500;
    transition: border-color 0.15s, color 0.15s;
  }
  .link-btn svg { width: 16px; height: 16px; fill: none; stroke: var(--muted); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; transition: stroke 0.15s; }
  .link-btn:hover { text-decoration: none; border-color: var(--accent); color: var(--accent); }
  .link-btn:hover svg { stroke: var(--accent); }
  .link-btn svg.filled { fill: var(--muted); stroke: none; }
  .link-btn:hover svg.filled { fill: var(--accent); }
  @media (max-width: 420px) { .links { gap: 6px; } .link-btn { padding: 0 9px; gap: 5px; font-size: 0.8rem; } }
  .facts { display: grid; grid-template-columns: auto 1fr; gap: 6px 14px; padding: 16px 18px; margin: 2.2rem 0 0; font-size: 0.9rem; }
  dt { color: var(--muted); }
  dd { margin: 0; }
  .empty { padding: 16px; }
  .trivia li { margin-bottom: 6px; }
  .lineage li { margin-bottom: 4px; }
  .where { margin-left: 6px; font-size: 0.75rem; color: var(--muted); white-space: nowrap; }
  .here { margin-left: 8px; font-size: 0.8rem; white-space: nowrap; }
  @media (max-width: 480px) { .here { white-space: normal; } }
  .cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 0 28px; }
  .pager { display: flex; justify-content: space-between; gap: 16px; margin-top: 40px; padding-top: 16px; border-top: 1px solid var(--border); font-size: 0.92rem; }
</style>
