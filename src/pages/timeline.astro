---
import Base from '../layouts/Base.astro';
import Preview from '../components/Preview.astro';
import CategoryFilter from '../components/CategoryFilter.astro';
import { getDatasets, MODALITIES, url } from '../lib/data';
const all = await getDatasets();
const counts = Object.fromEntries(Object.keys(MODALITIES).map((m) => [m, all.filter((d) => d.data.modality === m).length]));
const decades = [...new Set(all.map((d) => Math.floor(d.data.year / 10) * 10))];
---
<Base title="Timeline · AI Datasets" description="Classic AI datasets and benchmarks in the order they appeared.">
  <h1>Timeline</h1>
  <p class="muted">The history of AI, told through what people measured it on.</p>

  <CategoryFilter counts={counts} />

  <ol class="tl">
    {decades.map((dec) => (
      <>
        <li class="decade" data-decade={dec}>{dec}s</li>
        {all.filter((ds) => Math.floor(ds.data.year / 10) * 10 === dec).map((ds) => (
          <li class="item" data-filter-item data-m={ds.data.modality} data-decade={dec}>
            <span class="y">{ds.data.year}</span>
            <div class="body">
              <a href={url(`/d/${ds.id}`)}><strong>{ds.data.name}</strong></a>
              <span class="tag" data-m={ds.data.modality}>{MODALITIES[ds.data.modality]}</span>
              <p class="muted">{ds.data.one_liner}</p>
            </div>
            <a class="preview" href={url(`/d/${ds.id}`)} tabindex="-1" aria-hidden="true"><Preview ds={ds} /></a>
          </li>
        ))}
      </>
    ))}
  </ol>
</Base>

<script>
  // Filtering is done by CategoryFilter; here we only hide decades with nothing visible.
  const items = [...document.querySelectorAll<HTMLElement>('.tl .item')];
  const decades = [...document.querySelectorAll<HTMLElement>('.tl .decade')];
  const refresh = () =>
    decades.forEach((h) => (h.hidden = !items.some((li) => !li.hidden && li.dataset.decade === h.dataset.decade)));
  window.addEventListener('categoryfilter', refresh);
  refresh();
</script>

<style>
  .tl { list-style: none; padding: 0; margin: 16px 0; border-left: 2px solid var(--border); }
  .tl [hidden] { display: none; }
  .decade { font-weight: 700; color: var(--muted); font-size: 0.85rem; letter-spacing: 0.08em; padding: 14px 0 8px 16px; }
  /* Every entry shows its data inline: beside the text on wide screens, under it on narrow ones. */
  .item {
    display: grid; grid-template-columns: 56px minmax(0, 1fr) 320px; grid-template-areas: 'y body preview';
    gap: 8px 20px; align-items: start; padding: 12px 12px 14px 16px; position: relative; border-radius: 10px;
  }
  .item::before { content: ''; position: absolute; left: -7px; top: 19px; width: 12px; height: 12px; border-radius: 50%; background: var(--c, var(--accent)); box-shadow: 0 0 0 3px var(--bg); }
  .item:hover { background: var(--surface); }
  .y { grid-area: y; font-weight: 700; font-variant-numeric: tabular-nums; }
  .body { grid-area: body; }
  .body p { margin: 4px 0 0; font-size: 0.92rem; }
  .tag { margin-left: 8px; vertical-align: 2px; }
  .preview { grid-area: preview; display: block; color: inherit; }
  .preview:hover { text-decoration: none; }
  @media (max-width: 860px) {
    .item { grid-template-columns: 56px minmax(0, 1fr); grid-template-areas: 'y body' '. preview'; }
    .preview { max-width: 360px; }
  }
</style>
