---
import Base from '../layouts/Base.astro';
import Preview from '../components/Preview.astro';
import CategoryFilter from '../components/CategoryFilter.astro';
import {
  checkTrackBuildsOn, getDatasets, getPapers, getTracks, MODALITIES, trackTimeline, url,
  type Dataset, type Paper,
} from '../lib/data';

const [all, papers, tracks] = await Promise.all([getDatasets(), getPapers(), getTracks()]);
const dsById = new Map(all.map((d) => [d.id, d]));
const pById = new Map(papers.map((p) => [p.id, p]));
for (const t of tracks) checkTrackBuildsOn(t, pById);

// Per-mode category counts so the filter chips stay accurate in Datasets, Papers, and Both views.
const countsByMode = {
  datasets: Object.fromEntries(Object.keys(MODALITIES).map((m) => [m, all.filter((d) => d.data.modality === m).length])),
  papers: Object.fromEntries(Object.keys(MODALITIES).map((m) => [m, papers.filter((p) => p.data.category === m).length])),
  both: Object.fromEntries(
    Object.keys(MODALITIES).map((m) => [
      m,
      all.filter((d) => d.data.modality === m).length + papers.filter((p) => p.data.category === m).length,
    ]),
  ),
};
// Pass non-zero counts across both so CategoryFilter renders every category chip (including Foundations).
const initCounts = countsByMode.both;

// Datasets and papers on one axis; within a year, datasets come first.
type Item = { kind: 'dataset'; ds: Dataset; year: number } | { kind: 'paper'; p: Paper; year: number };
const items: Item[] = [
  ...all.map((ds) => ({ kind: 'dataset' as const, ds, year: ds.data.year })),
  ...papers.map((p) => ({ kind: 'paper' as const, p, year: p.data.year })),
].sort((a, b) => a.year - b.year || (a.kind === b.kind ? 0 : a.kind === 'dataset' ? -1 : 1));
const decades = [...new Set(items.map((it) => Math.floor(it.year / 10) * 10))];

const tracksPayload = Object.fromEntries(
  tracks.map((t) => {
    const seq = trackTimeline(t, dsById, pById);
    return [
      t.id,
      {
        id: t.id,
        title: t.data.title,
        one_liner: t.data.one_liner,
        intro: t.data.intro,
        color: t.data.categories[0] ?? 'other',
        papersUrl: url(`/papers?track=${t.id}`),
        items: seq.map((it) =>
          it.kind === 'dataset'
            ? { kind: 'dataset', id: it.ds.id }
            : { kind: 'paper', id: it.p.id, step: it.step, note: it.note },
        ),
      },
    ];
  }),
);
---
<Base title="Timeline · AI Datasets" description="Classic AI datasets and papers in the order they appeared.">
  <h1>Timeline</h1>
  <p class="muted">The history of AI, told through what people measured it on — and the papers that moved it forward.</p>

  <div class="controls">
    <div class="seg" role="group" aria-label="Show on timeline">
      <button type="button" data-mode="datasets" aria-pressed="true">Datasets <span class="n" data-mode-count="datasets">{all.length}</span></button>
      <button type="button" data-mode="papers" aria-pressed="false">Papers <span class="n" data-mode-count="papers">{papers.length}</span></button>
      <button type="button" data-mode="both" aria-pressed="false">Both <span class="n" data-mode-count="both">{all.length + papers.length}</span></button>
    </div>

    {tracks.length > 0 && (
      <div class="track-pills" role="group" aria-label="Filter by track">
        <span class="muted lbl">Track</span>
        <button type="button" class="tpill" data-track="" aria-pressed="true">All</button>
        {tracks.map((t) => (
          <button type="button" class="tpill" data-track={t.id} data-m={t.data.categories[0] ?? 'other'} aria-pressed="false">
            <span class="dot" aria-hidden="true"></span>{t.data.title}
          </button>
        ))}
      </div>
    )}
  </div>

  <div data-cat-wrap>
    <CategoryFilter counts={initCounts} />
  </div>

  <section class="card track-banner" data-track-banner hidden>
    <div class="tb-head">
      <h2 data-tb-title></h2>
      <div class="tb-actions">
        <a data-tb-papers href={url('/papers')}>See on Papers →</a>
        <button type="button" class="show-all" data-tb-clear>Show all</button>
      </div>
    </div>
    <p class="tb-intro muted" data-tb-intro></p>
  </section>

  <ol class="tl">
    {decades.map((dec) => (
      <>
        <li class="decade" data-decade={dec}>{dec}s</li>
        {items.filter((it) => Math.floor(it.year / 10) * 10 === dec).map((it) => it.kind === 'dataset' ? (
          <li class="item" data-filter-item data-kind="dataset" data-id={it.ds.id} data-m={it.ds.data.modality} data-decade={dec}>
            <span class="y">{it.year}</span>
            <div class="body">
              <a href={url(`/d/${it.ds.id}`)}><strong>{it.ds.data.name}</strong></a>
              <span class="tag" data-m={it.ds.data.modality}>{MODALITIES[it.ds.data.modality]}</span>
              <p class="muted">{it.ds.data.one_liner}</p>
            </div>
            <a class="preview" href={url(`/d/${it.ds.id}`)} tabindex="-1" aria-hidden="true"><Preview ds={it.ds} /></a>
          </li>
        ) : (
          <li class="item paper" data-filter-item data-kind="paper" data-id={it.p.id} data-m={it.p.data.category} data-decade={dec}>
            <span class="y">{it.year}</span>
            <div class="body">
              <span class="kind" data-kind-badge>Paper</span>
              <a href={url(`/p/${it.p.id}`)}><strong>{it.p.data.short}</strong></a>
              <p class="muted" data-one-liner>{it.p.data.one_liner}</p>
              <p class="track-note" data-track-note hidden></p>
              <p class="on">
                {it.p.data.datasets.map((r) => dsById.get(r.id)!).map((d, i) => (
                  <>{i === 0 ? 'On ' : ', '}<a href={url(`/d/${d.id}`)}>{d.data.name}</a> <span class="ago">({d.data.year})</span></>
                ))}
                {it.p.data.datasets.length === 0 && `Tested on: ${it.p.data.tested_on}`}
              </p>
            </div>
          </li>
        ))}
      </>
    ))}
  </ol>
</Base>

<script type="application/json" id="timeline-meta" set:html={JSON.stringify({ countsByMode, tracks: tracksPayload }).replace(/</g, '\\u003c')} />

<script>
  type Mode = 'datasets' | 'papers' | 'both';
  interface TrackItemRef { kind: 'dataset' | 'paper'; id: string; step?: number; note?: string }
  interface TrackData { id: string; title: string; one_liner: string; intro: string; color: string; papersUrl: string; items: TrackItemRef[] }

  const meta: { countsByMode: Record<Mode, Record<string, number>>; tracks: Record<string, TrackData> } = JSON.parse(
    document.getElementById('timeline-meta')!.textContent!,
  );

  const tl = document.querySelector<HTMLOListElement>('.tl')!;
  const origOrder = [...tl.children] as HTMLLIElement[];
  const allItems = [...tl.querySelectorAll<HTMLLIElement>('.item')];
  const decades = [...tl.querySelectorAll<HTMLLIElement>('.decade')];
  const itemByKey = new Map(allItems.map((li) => [`${li.dataset.kind}:${li.dataset.id}`, li]));

  const modeBtns = [...document.querySelectorAll<HTMLButtonElement>('[data-mode]')];
  const modeCounts = Object.fromEntries(
    (['datasets', 'papers', 'both'] as Mode[]).map((m) => [m, document.querySelector<HTMLElement>(`[data-mode-count="${m}"]`)!]),
  ) as Record<Mode, HTMLElement>;
  const trackBtns = [...document.querySelectorAll<HTMLButtonElement>('[data-track]')];
  const catWrap = document.querySelector<HTMLElement>('[data-cat-wrap]')!;
  const catEmpty = document.querySelector<HTMLElement>('[data-empty]');
  const catChips = [...document.querySelectorAll<HTMLButtonElement>('[data-cat-filter] [data-toggle]')];

  const banner = document.querySelector<HTMLElement>('[data-track-banner]')!;
  const tbTitle = banner.querySelector<HTMLElement>('[data-tb-title]')!;
  const tbIntro = banner.querySelector<HTMLElement>('[data-tb-intro]')!;
  const tbPapers = banner.querySelector<HTMLAnchorElement>('[data-tb-papers]')!;
  const tbClear = banner.querySelector<HTMLButtonElement>('[data-tb-clear]')!;

  const totalDatasets = allItems.filter((li) => li.dataset.kind === 'dataset').length;
  const totalPapers = allItems.filter((li) => li.dataset.kind === 'paper').length;

  let mode: Mode = 'datasets';
  let activeTrack: string = '';

  const activeCategories = () =>
    new Set(catChips.filter((c) => c.getAttribute('aria-pressed') === 'true').map((c) => c.dataset.toggle!));

  function updateUrl() {
    const q = new URLSearchParams(location.search);
    q.delete('papers');
    if (activeTrack) q.set('track', activeTrack);
    else q.delete('track');

    const defaultMode: Mode = activeTrack
      ? meta.tracks[activeTrack].items.some((x) => x.kind === 'dataset') ? 'both' : 'papers'
      : 'datasets';
    if (mode !== defaultMode) q.set('show', mode);
    else q.delete('show');

    const search = q.toString();
    history.replaceState(null, '', location.pathname + (search ? `?${search}` : '') + location.hash);
  }

  function restoreOrder() {
    for (const el of origOrder) tl.appendChild(el);
    for (const li of allItems) {
      if (li.dataset.kind === 'paper') {
        li.querySelector<HTMLElement>('[data-kind-badge]')!.textContent = 'Paper';
        li.querySelector<HTMLElement>('[data-one-liner]')!.hidden = false;
        const note = li.querySelector<HTMLElement>('[data-track-note]')!;
        note.hidden = true;
        note.textContent = '';
      }
    }
  }

  function render() {
    modeBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.mode === mode)));
    trackBtns.forEach((b) => b.setAttribute('aria-pressed', String((b.dataset.track ?? '') === activeTrack)));

    const track = activeTrack ? meta.tracks[activeTrack] : undefined;
    catWrap.hidden = Boolean(track);

    if (track) {
      banner.hidden = false;
      banner.dataset.m = track.color;
      tbTitle.textContent = track.title;
      tbIntro.textContent = track.intro;
      tbPapers.href = track.papersUrl;

      const tDs = track.items.filter((x) => x.kind === 'dataset').length;
      const tP = track.items.filter((x) => x.kind === 'paper').length;
      modeCounts.datasets.textContent = String(tDs);
      modeCounts.papers.textContent = String(tP);
      modeCounts.both.textContent = String(tDs + tP);
      // Hide "Datasets" option if a track has none (e.g. a Foundations track).
      modeBtns[0].hidden = tDs === 0;
      modeBtns[2].hidden = tDs === 0;
      if (tDs === 0 && mode !== 'papers') mode = 'papers';
      modeBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.mode === mode)));

      const keep = new Map(track.items.map((x, idx) => [`${x.kind}:${x.id}`, { ...x, idx }]));
      decades.forEach((h) => (h.hidden = true));
      for (const li of allItems) {
        const key = `${li.dataset.kind}:${li.dataset.id}`;
        const entry = keep.get(key);
        const kindOk = mode === 'both' || (mode === 'datasets' ? li.dataset.kind === 'dataset' : li.dataset.kind === 'paper');
        li.hidden = !(entry && kindOk);
        if (entry && li.dataset.kind === 'paper') {
          li.querySelector<HTMLElement>('[data-kind-badge]')!.textContent = `Step ${entry.step}`;
          li.querySelector<HTMLElement>('[data-one-liner]')!.hidden = true;
          const note = li.querySelector<HTMLElement>('[data-track-note]')!;
          note.textContent = entry.note ?? '';
          note.hidden = false;
        }
      }
      // Place matching items in the track's authored order (preserves same-year reading order).
      for (const entry of track.items) {
        const li = itemByKey.get(`${entry.kind}:${entry.id}`);
        if (li) tl.appendChild(li);
      }
      if (catEmpty) catEmpty.hidden = true;
    } else {
      banner.hidden = true;
      modeBtns[0].hidden = false;
      modeBtns[2].hidden = false;
      modeCounts.datasets.textContent = String(totalDatasets);
      modeCounts.papers.textContent = String(totalPapers);
      modeCounts.both.textContent = String(totalDatasets + totalPapers);

      restoreOrder();

      // Update category chip counts & hide categories with 0 items in the active mode.
      const counts = meta.countsByMode[mode];
      for (const chip of catChips) {
        const m = chip.dataset.toggle!;
        const n = counts[m] ?? 0;
        chip.style.display = n > 0 ? '' : 'none';
        const span = chip.querySelector<HTMLElement>('.n');
        if (span) span.textContent = String(n);
      }

      const on = activeCategories();
      for (const li of allItems) {
        const kindOk = mode === 'both' || (mode === 'datasets' ? li.dataset.kind === 'dataset' : li.dataset.kind === 'paper');
        const catOk = on.has(li.dataset.m!);
        li.hidden = !(kindOk && catOk);
      }
      decades.forEach((h) => {
        h.hidden = !allItems.some((li) => !li.hidden && li.dataset.decade === h.dataset.decade);
      });
      if (catEmpty) catEmpty.hidden = on.size > 0;
    }
    updateUrl();
  }

  modeBtns.forEach((b) =>
    b.addEventListener('click', () => {
      mode = b.dataset.mode as Mode;
      render();
    }),
  );
  trackBtns.forEach((b) =>
    b.addEventListener('click', () => {
      const next = b.dataset.track ?? '';
      activeTrack = next;
      if (activeTrack) {
        const hasDs = meta.tracks[activeTrack].items.some((x) => x.kind === 'dataset');
        mode = hasDs ? 'both' : 'papers';
      }
      render();
    }),
  );
  tbClear.addEventListener('click', () => {
    activeTrack = '';
    render();
  });
  window.addEventListener('categoryfilter', render);

  // Initialize from URL query parameters (?track=..., ?show=datasets|papers|both, or legacy ?papers).
  const q = new URLSearchParams(location.search);
  const qTrack = q.get('track') ?? '';
  if (qTrack && meta.tracks[qTrack]) activeTrack = qTrack;
  const qShow = q.get('show');
  if (qShow === 'datasets' || qShow === 'papers' || qShow === 'both') {
    mode = qShow;
  } else if (q.has('papers')) {
    mode = 'both';
  } else if (activeTrack) {
    mode = meta.tracks[activeTrack].items.some((x) => x.kind === 'dataset') ? 'both' : 'papers';
  } else {
    mode = 'datasets';
  }
  render();
</script>

<style>
  .controls { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 18px; margin: 16px 0 0; }
  .seg {
    display: inline-flex; padding: 3px; border-radius: 10px;
    border: 1px solid var(--border); background: var(--surface); gap: 2px;
  }
  .seg button {
    border: 0; background: transparent; padding: 5px 12px; border-radius: 7px;
    font-size: 0.85rem; color: var(--muted); font-weight: 500;
    transition: background 0.15s, color 0.15s;
  }
  .seg button:hover { color: var(--text); }
  .seg button[aria-pressed='true'] { background: var(--accent-soft); color: var(--accent); font-weight: 600; }
  .seg button[hidden] { display: none; }
  .seg .n { margin-left: 4px; font-size: 0.78rem; font-weight: 400; font-variant-numeric: tabular-nums; opacity: 0.85; }

  .track-pills { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
  .lbl { font-size: 0.82rem; margin-right: 2px; }
  .tpill {
    display: inline-flex; align-items: center; gap: 6px; padding: 5px 11px; border-radius: 999px;
    border: 1px solid var(--border); background: var(--surface); color: var(--muted);
    font-size: 0.82rem; font-weight: 500; transition: border-color 0.15s, color 0.15s, background 0.15s;
  }
  .tpill:hover { color: var(--text); border-color: color-mix(in srgb, var(--c, var(--accent)) 45%, var(--border)); }
  .tpill[aria-pressed='true'] {
    color: var(--text); font-weight: 600;
    border-color: color-mix(in srgb, var(--c, var(--accent)) 55%, var(--border));
    background: color-mix(in srgb, var(--c, var(--accent)) 10%, var(--surface));
  }
  .tpill .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--c, var(--accent)); }

  [data-cat-wrap][hidden], .track-banner[hidden] { display: none; }
  .track-banner {
    margin: 16px 0 4px; padding: 14px 18px; max-width: 760px;
    border-left: 3px solid var(--c, var(--accent));
  }
  .tb-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 8px 16px; }
  .tb-head h2 { margin: 0; font-size: 1.15rem; }
  .tb-actions { display: flex; align-items: baseline; gap: 12px; font-size: 0.85rem; }
  .tb-actions .show-all { border: 0; background: none; padding: 0; color: var(--muted); font-size: 0.85rem; cursor: pointer; }
  .tb-actions .show-all:hover { color: var(--text); text-decoration: underline; }
  .tb-intro { margin: 8px 0 0; font-size: 0.92rem; }

  /* Capped width keeps one-liners short and each preview next to its text. */
  .tl { list-style: none; padding: 0; margin: 16px 0; border-left: 2px solid var(--border); max-width: 760px; }
  .tl [hidden] { display: none !important; }
  .decade { font-weight: 700; color: var(--muted); font-size: 0.85rem; letter-spacing: 0.08em; padding: 14px 0 8px 16px; }
  /* Each entry reads top to bottom: name, one-liner, then a glimpse of the data. */
  .item {
    display: grid; grid-template-columns: 56px minmax(0, 1fr); grid-template-areas: 'y body' '. preview';
    gap: 10px 16px; align-items: start; padding: 12px 12px 16px 16px; position: relative; border-radius: 10px;
  }
  .item::before { content: ''; position: absolute; left: -7px; top: 19px; width: 12px; height: 12px; border-radius: 50%; background: var(--c, var(--accent)); box-shadow: 0 0 0 3px var(--bg); }
  .item:hover { background: var(--surface); }
  .y { grid-area: y; font-weight: 700; font-variant-numeric: tabular-nums; }
  .body { grid-area: body; }
  /* Dataset names take their category color, like the dot and the tag. */
  .body > a { color: var(--c, var(--accent)); }
  .body p { margin: 4px 0 0; font-size: 0.92rem; }
  .tag { margin-left: 8px; vertical-align: 2px; }
  .preview { grid-area: preview; display: block; color: inherit; max-width: 420px; }
  .preview:hover { text-decoration: none; }

  /* Papers: hollow dot and no preview, so datasets and papers stay visually distinct. */
  .paper { grid-template-areas: 'y body'; padding-bottom: 12px; }
  .paper::before { background: var(--bg); border: 2.5px solid var(--c, var(--accent)); box-sizing: border-box; }
  .paper .body > a { color: var(--text); }
  .kind {
    display: inline-block; margin-right: 8px; vertical-align: 2px; font-size: 0.68rem; font-weight: 700;
    letter-spacing: 0.06em; text-transform: uppercase; color: var(--c); border: 1px solid color-mix(in srgb, var(--c) 45%, transparent);
    border-radius: 4px; padding: 0 5px;
  }
  .track-note { color: var(--text); }
  .on { font-size: 0.85rem !important; color: var(--muted); }
  .ago { color: var(--muted); font-variant-numeric: tabular-nums; }
</style>
